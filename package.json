{
  "name": "@google/aside",
  "version": "1.5.0",
  "type": "module",
  "description": "Apps Script IDE framework",
  "bin": "dist/src/index.js",
  "files": [
    ".claspignore",
    ".editorconfig",
    ".prettierignore",
    ".prettierrc.cjs",
    "deploy-ui.mjs",
    "dist/src",
    "dist/.gitignore-target",
    "eslint.config.cjs",
    "eslint.ignores.cjs",
    "fix-animations.mjs",
    "jest.config.json",
    "LICENSE",
    "license-config.json",
    "license-header.txt",
    "rollup.config.mjs",
    "template",
    "template-ui",
    "tsconfig.json",
    "tsconfig.template.json"
  ],
  "repository": "google/aside",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf build",
    "lint": "npm run license && eslint --fix src/ test/",
    "lint:staged": "npm run license && lint-staged",
    "build": "npm run clean && npm run lint && tsc && npm run copy-files",
    "license": "license-check-and-add add -f license-config.json",
    "test": "jest test/ --detectOpenHandles",
    "copy-files": "ncp .gitignore dist/.gitignore-target",
    "prepare": "is-ci || husky install"
  },
  "keywords": [
    "typescript",
    "apps-script",
    "ide",
    "google"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Google Inc.",
  "license": "Apache-2.0",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/google-apps-script": "^2.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/prompts": "^2.4.9",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "gts": "^7.0.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^30.4.2",
    "license-check-and-add": "^4.0.5",
    "ncp": "^2.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.4",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cross-spawn": "^7.0.6",
    "fs-extra": "^11.3.5",
    "json5": "^2.2.3",
    "lint-staged": "^17.0.5",
    "meow": "^14.1.0",
    "prompts": "^2.4.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-prettier": "^4.1.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "write-file-atomic": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4"
  }
}
